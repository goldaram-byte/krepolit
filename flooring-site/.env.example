# PostgreSQL connection string used by Prisma (see prisma.config.ts).
DATABASE_URL="postgresql://user:password@localhost:5432/flooring?schema=public"

# Telegram bot used to notify the owner about new leads (long polling, see SPEC.md §2).
# Create a bot via @BotFather, then message it once and read the chat id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Yandex.Metrika counter id (see src/components/analytics/YandexMetrika.tsx).
# Leave empty until a real counter is created — the site works fine without it.
NEXT_PUBLIC_YANDEX_METRIKA_ID=""

# Base URL used to build absolute links in sitemap.xml, robots.txt and the
# YML feed. Must match the real production domain once one exists.
NEXT_PUBLIC_SITE_URL="https://example.com"
